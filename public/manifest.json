{
  "manifest_version": 3,
  "name": "课间哨 · 直播二维码提醒",
  "version": "0.1.0",
  "description": "监控课程直播画面中的二维码，以声音提醒；支持检测间隔、自定义铃声及后台打开链接。",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "tabCapture", "offscreen", "storage", "notifications", "alarms"],
  "action": { "default_popup": "popup.html", "default_title": "课间哨", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "options_page": "settings.html",
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+Q" }, "description": "打开课间哨控制面板" } },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "incognito": "not_allowed"
}
